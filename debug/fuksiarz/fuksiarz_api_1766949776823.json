      "html": "<sb-cms-page id=\"cms-page-107\" sb-cms-df0a918d03=\"\">\n <sb:place-holder-container id=\"place-holder-container-1\" sb-cms-c1b401c98f=\"\">\n  <div class=\"place-holder-container\">\n   <sb:container-column-100 id=\"container-column-100-1\" sb-cms-67e6ffb715=\"\"> \n    <div class=\"container-column-100\"> \n     <sb:categories-menu id=\"categories-menu-1\" sb-cms-60aaa3433c=\"\"> \n      <sb-categories-menu> \n       <sb-categories-menu-list></sb-categories-menu-list> \n       <sb-categories-menu-content></sb-categories-menu-content> \n      </sb-categories-menu> \n     </sb:categories-menu> \n    </div> \n   </sb:container-column-100>\n  </div>\n </sb:place-holder-container>\n <style>[sb-cms-60aaa3433c] {\r\n  width: 100%; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu {\r\n    display: blcok; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list {\r\n    display: block;\r\n    width: 100%;\r\n    background: #c62828; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-content {\r\n    display: block;\r\n    width: 100%; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list > sb-categories-menu-list-links {\r\n    margin-left: 0px; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-links {\r\n    height: 100%;\r\n    display: flex;\r\n    flex: 0 1 auto;\r\n    margin-right: 0;\r\n    padding-left: 0; }\r\n    [sb-cms-60aaa3433c] sb-categories-menu-list-links a {\r\n      display: flex;\r\n      justify-content: center;\r\n      align-items: center;\r\n      margin-right: 2.66667rem;\r\n      text-transform: uppercase;\r\n      line-height: 1;\r\n      font-size: 1.1666666666666667rem;\r\n      font-weight: 400;\r\n      font-style: normal;\r\n      padding: 0;\r\n      text-decoration: none;\r\n      position: relative;\r\n      cursor: pointer;\r\n      color: #FFF; }\r\n      [sb-cms-60aaa3433c] sb-categories-menu-list-links a:last-of-type {\r\n        margin-right: 0; }\r\n      [sb-cms-60aaa3433c] sb-categories-menu-list-links a > * {\r\n        pointer-events: none; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-li sb-categories-menu-list-ul {\r\n    display: none; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-li {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-right: 2.66667rem;\r\n    text-transform: uppercase; }\r\n    [sb-cms-60aaa3433c] sb-categories-menu-list-li:last-of-type {\r\n      margin-right: 0; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-title {\r\n    height: 100%;\r\n    line-height: 1;\r\n    width: 100%;\r\n    font-size: 1.1666666666666667rem;\r\n    font-weight: 400;\r\n    font-style: normal;\r\n    padding: 0;\r\n    text-decoration: none;\r\n    margin-right: 0;\r\n    display: flex;\r\n    align-items: center;\r\n    position: relative;\r\n    cursor: pointer;\r\n    color: #FFF; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-li.sb-active {\r\n    text-decoration: none;\r\n    color: #FFF; }\r\n  [sb-cms-60aaa3433c] sb-categories-menu-list-li.sb-active > sb-categories-menu-list-ul {\r\n    display: block;\r\n    margin-left: 0; }\r\n[sb-cms-67e6ffb715] {\r\n  display: flex;\r\n  width: 100%; }\r\n  [sb-cms-67e6ffb715] .container-column-100 {\r\n    width: calc(100% + 30px);\r\n    margin-left: -15px;\r\n    margin-right: -15px;\r\n    padding-top: .5rem;\r\n    padding-bottom: .5rem;\r\n    display: flex;\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    justify-content: space-between; }\r\n  [sb-cms-67e6ffb715] .container-column-100 > * {\r\n    padding-left: 15px;\r\n    padding-right: 15px; }\r\n[sb-cms-c1b401c98f] .place-holder-container {\r\n  display: flex;\r\n  flex: 0 1 43rem;\r\n  margin-right: .83rem;\r\n  padding: 0; }\r\n\r\n[sb-cms-c1b401c98f] .place-holder-container a {\r\n  text-transform: initial; }\r\n</style>\n <script>(function () {\n  var CategoriesMenu = function () {\n    this.parentElement = document.querySelectorAll('[sb-cms-60aaa3433c]')[0];\n    this.url = app.config.domainUrl + '/rest/cms/categories/7'\n\n    this.init = function () {\n      var self = this\n      this.httpRequest(this.url, 'GET', null, function (data) {\n        self.recursiveList.call(self, data, self.parentElement.getElementsByTagName('sb-categories-menu-list')[0])\n      })\n    }\n\n    this.recursiveList = function (object, node) {\n      var list = document.createElement(\"sb-categories-menu-list-links\");\n      var self = this\n      if (object && object.subCategories)\n        for (let child of object.subCategories) {\n\n            var hiddenRobotLink = document.createElement(\"a\")\n            hiddenRobotLink.setAttribute('href', child.url)\n            hiddenRobotLink.textContent = child.name\n          \thiddenRobotLink.addEventListener('click', function(evt) { self.redirect.call(child, evt, self) });\n\n            if (child.subCategories.length > 0) {\n              self.recursiveList(child, item);\n            }\n            list.appendChild(hiddenRobotLink);\n        }\n      if (list.parentElement != null) {\n        item.appendChild(list);\n      }\n      node.appendChild(list);\n    }\n\n    this.redirect = function (event, self) {\n      event.preventDefault();\n      self.toggleElement.call(self, event)\n      event.stopPropagation();\n      if (this.url && /^http|^www/i.test(this.url)) {\n      \t\twindow.location.href = this.url;\n      }else if (this.url) {\n        app.router.redirect(this.url);\n        console.log(this.url);\n\n        return\n      }\n      if (this.pageId) {\n        console.log(this.pageId);\n        self.httpRequest(app.config.domainUrl + '/rest/cms/pages/' + this.pageId + '/content?wrapComponents=true', 'GET', null, self.renderPage.bind(self))\n      }\n    }\n\n    this.renderPage = function (data) {\n      var contentElement = this.parentElement.getElementsByTagName('sb-categories-menu-content')[0]\n      contentElement.innerHTML = '';\n\n\n      var html = data.html\n\n      var div = document.createElement('div')\n      div.innerHTML = html\n      contentElement.appendChild(div)\n\n      var componentsScript = JSON.parse(data.js)\n      for (var key in componentsScript) {\n        var script = document.createElement('script');\n        script.innerHTML = JSON.parse(data.js)[key]\n        contentElement.appendChild(script)\n      }\n    }\n\n    this.toggleElement = function (event) {\n    \n        let list = this.parentElement.getElementsByTagName('sb-categories-menu-list-links')[0].children\n        for (i = 0; i < list.length; i++) {\n          let li = list[i]\n          if (li.classList.contains('sb-active')) {\n            li.classList.remove(\"sb-active\")\n        }\n        event.target.classList.add(\"sb-active\")\n      }\n    }\n\n    this.httpRequest = function (theUrl, method, request, callback) {\n      var xmlHttp = new XMLHttpRequest()\n      xmlHttp.open(method, theUrl, true)\n      xmlHttp.setRequestHeader('Content-type', 'application/json')\n      xmlHttp.setRequestHeader(\"request-language\", \"pl\");\n\n      xmlHttp.onload = function (e) {\n        if (xmlHttp.readyState === 4) {\n          if (xmlHttp.status === 200 && callback) {\n            try {\n              var json = JSON.parse(xmlHttp.responseText)\n              callback(json.data)\n            } catch (e) {}\n          } else {\n            console.error(xmlHttp.statusText);\n          }\n        }\n      };\n      xmlHttp.onerror = function (e) {\n        console.error(xmlHttp.statusText);\n      };\n\n      xmlHttp.send(JSON.stringify(request))\n    }\n\n    this.init()\n  }\n  new CategoriesMenu()\n})()</script>\n <script> </script>\n</sb-cms-page>",
