# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - origin(s) allowed to call this API (e.g. the frontend app's URL)
CORS_ORIGIN=http://localhost:3000

# Admin API Key (for protected endpoints, e.g. manual scrape triggers)
ADMIN_API_KEY=your-admin-api-key

# Scraper Configuration
# Minutes between scrape run starts (integer 1-1440, ±10 % jitter; default 30)
SCRAPE_INTERVAL_MINUTES=5
# Set to "false" to disable the scheduled scraper loop (API still serves stored data)
SCRAPERS_ON=true
# auto: scrape on boot only if the last OK run is older than SCRAPE_INTERVAL_MINUTES; always | never
STARTUP_SCRAPE=auto

# Alerts
# Consecutive failed runs of one bookmaker before an [ALERT] line fires (a positive integer;
# default 3, and any other value falls back to 3 with a startup warning)
# ALERT_CONSECUTIVE_FAILURES=3
# Optional Slack-compatible webhook that receives the alert lines as {"text": ...}; unset = stderr only
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Incremental scraping (plan 10). Off by default: every bookmaker keeps its full pass every
# SCRAPE_INTERVAL_MINUTES. Listed bookmakers list their events every INCREMENTAL_PASS_MINUTES
# and fetch a match's detail only when its kickoff tier or a listing price change makes it due.
# Live mode needs migration 16 and ODDS_WRITE_MODEL=switched or snapshot; an invalid value
# logs one error at startup and keeps incremental mode off.
# INCREMENTAL_BOOKMAKERS=forbet,etoto,fuksiarz,betfan
# Minutes between listing passes: an integer from 5 to SCRAPE_INTERVAL_MINUTES (default 10)
# INCREMENTAL_PASS_MINUTES=10
# true/1: keep the full pass and only log what incremental mode would fetch (no DB writes of its own)
# INCREMENTAL_DRY_RUN=false

# Odds storage
# Keep a match's previous snapshot when a write is degenerate (>= 20 rows before, < 10 % now); off by default (owner B13)
# ODDS_PRUNE_GUARD=false
# Where odds are written (default legacy); the owner changes it between runs, with a restart:
#   legacy   = table odds only
#   dual     = odds and the snapshot model, odds primary
#   switched = both, the snapshot model primary
#   snapshot = the snapshot model only
# ODDS_WRITE_MODEL=legacy
# Leave stale quotes out of best odds (default false: stale quotes are only flagged, owner B12)
# EXCLUDE_STALE_FROM_BEST_ODDS=false

# Betclic
# BETCLIC_MATCH_CONCURRENCY=3   # matches fetched at a time (1-7); 1 = sequential reference run

# Normalization
# Set to "true" to log one "[Normalizer] Market mapped to OTHER" line per unmapped market (default: one [ScrapeHelpers] summary line per bookmaker per run)
# NORMALIZER_LOG_OTHER=true

# Per-bookmaker fallback to the old Playwright scraper (plans 03-05), e.g.:
# SCRAPER_TRANSPORT_STS=browser
