      "html": "<sb-cms-page id=\"cms-page-109\" sb-cms-e71e528429=\"\">\n <sb:place-holder-container id=\"place-holder-container-1\" sb-cms-7a1e28a30d=\"\">\n  <div class=\"place-holder-container\">\n   <sb:container-column-100 id=\"container-column-100-1\" sb-cms-7a35d30eed=\"\"> \n    <div class=\"container-column-100\"> \n     <sb:categories-menu id=\"categories-menu-1\" sb-cms-97bde0361b=\"\"> \n      <sb-categories-menu> \n       <sb-categories-menu-list></sb-categories-menu-list> \n       <sb-categories-menu-content></sb-categories-menu-content> \n      </sb-categories-menu> \n     </sb:categories-menu> \n    </div> \n   </sb:container-column-100>\n  </div>\n </sb:place-holder-container>\n <style>[sb-cms-97bde0361b] {\r\n  width: 100%; }\r\n  [sb-cms-97bde0361b] sb-categories-menu {\r\n    display: flex;\r\n    height: 100%; }\r\n  [sb-cms-97bde0361b] sb-categories-menu-list {\r\n    flex: 1 10%; }\r\n  [sb-cms-97bde0361b] sb-categories-menu-content {\r\n    flex: 1 90%; }\r\n  [sb-cms-97bde0361b] sb-categories-menu-list > sb-categories-menu-list-links {\r\n    margin-left: 0px; }\r\n  [sb-cms-97bde0361b] sb-categories-menu-list-links {\r\n    display: flex;\r\n    flex: 0 1 43rem;\r\n    margin-right: .83rem;\r\n    padding: 0;\r\n    height: 100%; }\r\n    [sb-cms-97bde0361b] sb-categories-menu-list-links a {\r\n      display: flex;\r\n      cursor: pointer;\r\n      text-overflow: ellipsis;\r\n      transition: .2s all linear;\r\n      text-align: center;\r\n      padding: 0;\r\n      margin-right: 1.16667rem;\r\n      height: 100%;\r\n      position: relative;\r\n      line-height: 1;\r\n      color: #000;\r\n      width: 100%;\r\n      font-size: 14px;\r\n      font-weight: 400;\r\n      font-style: normal;\r\n      align-items: center;\r\n      text-decoration: none; }\r\n      @media screen and (min-width: 1281px) {\r\n        [sb-cms-97bde0361b] sb-categories-menu-list-links a {\r\n          white-space: nowrap; } }\r\n      [sb-cms-97bde0361b] sb-categories-menu-list-links a > * {\r\n        pointer-events: none; }\r\n      [sb-cms-97bde0361b] sb-categories-menu-list-links a:after {\r\n        display: none; }\r\n      [sb-cms-97bde0361b] sb-categories-menu-list-links a:last-of-type {\r\n        margin-right: 0; }\r\n      [sb-cms-97bde0361b] sb-categories-menu-list-links a:hover:after, [sb-cms-97bde0361b] sb-categories-menu-list-links a.sb-active:after {\r\n        content: '';\r\n        position: absolute;\r\n        bottom: 0;\r\n        left: 0;\r\n        right: 0;\r\n        height: 2px;\r\n        background-color: #c62828;\r\n        display: block;\r\n        z-index: 1; }\r\n  @media screen and (max-width: 1280px) {\r\n    [sb-cms-97bde0361b] sb-categories-menu-list-links a {\r\n      min-width: 7.5rem; }\r\n    [sb-cms-97bde0361b] sb-categories-menu-list-links > sb-categories-menu-list-title {\r\n      font-size: 1.13rem;\r\n      justify-content: center; } }\r\n[sb-cms-7a35d30eed] {\r\n  display: flex;\r\n  width: 100%;\r\n  height: 100%; }\r\n  [sb-cms-7a35d30eed] .container-column-100 {\r\n    display: flex;\r\n    flex-direction: row;\r\n    flex-wrap: wrap;\r\n    justify-content: space-between; }\r\n[sb-cms-7a1e28a30d] {\r\n  /*.place-holder-container p {word-break: break-all;}*/ }\r\n  [sb-cms-7a1e28a30d] .place-holder-container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    box-sizing: border-box;\r\n    max-width: 1440px;\r\n    width: auto;\r\n    margin: 0px auto;\r\n    height: 100%;\r\n    background: #FFF; }\r\n  [sb-cms-7a1e28a30d] .place-holder-container * {\r\n    box-sizing: border-box; }\r\n</style>\n <script>(function () {\n  var CategoriesMenu = function () {\n    this.parentElement = document.querySelectorAll('[sb-cms-97bde0361b]')[0];\n    this.url = app.config.domainUrl + '/rest/cms/categories/28'\n\n    this.init = function () {\n      var self = this\n      this.httpRequest(this.url, 'GET', null, function (data) {\n        self.recursiveList.call(self, data, self.parentElement.getElementsByTagName('sb-categories-menu-list')[0])\n        self.markActive()\n      })\n      \tapp.router.onRouteChange('menuSelectionUpdate', function () {\n          self.markActive()\n        });\n    }\n\n    this.recursiveList = function (object, node) {\n      var list = document.createElement(\"sb-categories-menu-list-links\");\n      var self = this\n      if (object && object.subCategories)\n        for (let child of object.subCategories) {\n          \n          var link = document.createElement(\"a\")\n          link.setAttribute('href', child.url)\n          link.innerHTML = child.name\n          link.addEventListener('click', function(evt) { self.redirect.call(child, evt, self) });\n\n          if (child.subCategories.length > 0) {\n            self.recursiveList(child, item);\n          }\n          list.appendChild(link);\n        }\n      if (list.parentElement != null) {\n        item.appendChild(list);\n      }\n      node.appendChild(list);\n    }\n\n    this.redirect = function (event, self) {\n      event.preventDefault();\n      self.toggleElement.call(self, event)\n      event.stopPropagation();\n\n      if (this.url) {\n        app.router.redirect(this.url)\n        console.log(this.url);\n\n        return\n      }\n      if (this.pageId) {\n        console.log(this.pageId);\n        self.httpRequest(app.config.domainUrl + '/rest/cms/pages/' + this.pageId + '/content?wrapComponents=true', 'GET', null, self.renderPage.bind(self))\n      }\n    }\n\n    this.renderPage = function (data) {\n      var contentElement = this.parentElement.getElementsByTagName('sb-categories-menu-content')[0]\n      contentElement.innerHTML = '';\n\n\n      var html = data.html\n\n      var div = document.createElement('div')\n      div.innerHTML = html\n      contentElement.appendChild(div)\n\n      var componentsScript = JSON.parse(data.js)\n      for (var key in componentsScript) {\n        var script = document.createElement('script');\n        script.innerHTML = JSON.parse(data.js)[key]\n        contentElement.appendChild(script)\n      }\n    }\n\n    this.toggleElement = function (event) {\n    \n        let list = this.parentElement.getElementsByTagName('sb-categories-menu-list-links')[0].children\n        for (i = 0; i < list.length; i++) {\n          let li = list[i]\n          if (li.classList.contains('sb-active')) {\n            li.classList.remove(\"sb-active\")\n        }\n        event.target.classList.add(\"sb-active\")\n      }\n    }\n\n    this.httpRequest = function (theUrl, method, request, callback) {\n      var xmlHttp = new XMLHttpRequest()\n      xmlHttp.open(method, theUrl, true)\n      xmlHttp.setRequestHeader('Content-type', 'application/json')\n      xmlHttp.setRequestHeader(\"request-language\", \"pl\");\n\n      xmlHttp.onload = function (e) {\n        if (xmlHttp.readyState === 4) {\n          if (xmlHttp.status === 200 && callback) {\n            try {\n              var json = JSON.parse(xmlHttp.responseText)\n              callback(json.data)\n            } catch (e) {}\n          } else {\n            console.error(xmlHttp.statusText);\n          }\n        }\n      };\n      xmlHttp.onerror = function (e) {\n        console.error(xmlHttp.statusText);\n      };\n\n      xmlHttp.send(JSON.stringify(request))\n    }\n\n    this.markActive = function () {\n      const links = $('sb-categories-menu-list-links a');\n      \n      for (var key in links) {\n    \t\tvar item = links[key]\n    \t\tif (item && item.classList) {\n\t    \t\tif (item.classList.contains('sb-active')) {\n\t\t\t\t\titem.classList.remove('sb-active')\n\t\t\t\t}\n\t\t\t}\n    \t}\n      \n      var pathname = window.location.pathname\n      if (pathname) {\n        pathname  = pathname.replace(/^\\//, '').split('/')[0]\n      }\n      var active = $('sb-categories-menu-list-links a[href*=\"'+pathname+'\"]')\n      if (active) {\n        active.addClass(\"sb-active\")\n      }\n    }    \n\n    this.init()\n  }\n  new CategoriesMenu()\n})()\n\n\n</script>\n <script> </script>\n</sb-cms-page>",
