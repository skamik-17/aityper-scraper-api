{
  "name": "aityper-backend",
  "version": "1.0.0",
  "description": "Backend service for AITyper - scrapes odds from Polish bookmakers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "./scripts/apply-migrations.sh",
    "test:scraper": "tsx -e \"console.log('Use npm run dev to start the server with scrapers')\""
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "fuse.js": "^7.1.0",
    "node-cron": "^3.0.3",
    "p-limit": "^7.2.0",
    "playwright": "^1.57.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
