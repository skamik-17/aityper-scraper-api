# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - origin(s) allowed to call this API (e.g. the frontend app's URL)
CORS_ORIGIN=http://localhost:3000

# Admin API Key (for protected endpoints, e.g. manual scrape triggers)
ADMIN_API_KEY=your-admin-api-key

# Scraper Configuration
SCRAPE_INTERVAL_MINUTES=5
SCRAPER_TIMEOUT_MS=30000
# Set to "false" to disable the scheduled scraper loop (API still serves stored data)
SCRAPERS_ON=true
